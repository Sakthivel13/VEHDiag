/* ============================================================================
 * Vehicle Diagnostics Platform - dark theme
 *
 * This file is the *baseline* stylesheet of the dark theme, generated at a
 * reference DPI scale of 1.0 (96 DPI). At runtime
 * :class:`ui.theme_manager.ThemeManager` regenerates the same rules with the
 * real DPI scale so paddings and radii follow the screen; this file is used
 * as a fallback, as a starting point for custom themes and as the reference
 * when reviewing the palette.
 *
 * Palette (from the design specification):
 *   background       #1E1E2E
 *   surface          #282840
 *   surface_alt      #31314D
 *   primary          #7C3AED
 *   secondary        #06B6D4
 *   success          #22C55E
 *   warning          #F59E0B
 *   error            #EF4444
 *   info             #38BDF8
 *   text_primary     #F8FAFC
 *   text_secondary   #94A3B8
 *   text_disabled    #64748B
 *   border           #374151
 *   border_focus     #7C3AED
 *   selection        #4C1D95
 *   tx               #38BDF8
 *   rx               #22C55E
 *   elevated_1       #282837
 *   elevated_2       #323241
 *   elevated_3       #3C3C4A
 *   hover            #3F3F59
 *   pressed          #2B2B44
 *   border_subtle    #2C3141
 *   on_primary       #FFFFFF
 *   on_success       #101014
 *   on_warning       #101014
 *   on_error         #101014
 *   primary_hover    #8E56F0
 *   primary_press    #6831C7
 *   error_hover      #F15E5E
 *   success_hover    #41CD75
 *   primary_soft     #332458
 *   success_soft     #1F3C37
 *   warning_soft     #453528
 *   error_soft       #442532
 *   info_soft        #233B52
 *
 * Regenerate with:  python scripts/generate_resources.py --stylesheets
 * ==========================================================================*/

/* ============================================================================
 * Vehicle Diagnostics Platform - dark theme
 * Generated at DPI scale 1.00. Do not edit by hand.
 * ==========================================================================*/

/* ---- base ---------------------------------------------------------------- */
QWidget {
    background-color: #1E1E2E;
    color: #F8FAFC;
    selection-background-color: #7C3AED;
    selection-color: #FFFFFF;
}
QMainWindow, QDialog { background-color: #1E1E2E; }
QWidget:disabled { color: #64748B; }

/* ---- typography ---------------------------------------------------------- */
/* No min-height here: QFormLayout sizes a row from its tallest item, and a
 * forced label height makes short rows overlap on compact screens. */
QLabel { background: transparent; }
QLabel[role="heading"] { color: #F8FAFC; font-weight: 600; }
QLabel[role="secondary"] { color: #94A3B8; }
QLabel[role="mono"] { font-family: "JetBrains Mono", "Roboto Mono", "DejaVu Sans Mono", "Consolas", monospace; }
QLabel[role="caption"] {
    color: #94A3B8;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ---- containers ---------------------------------------------------------- */
QGroupBox {
    background-color: #282837;
    border: 1px solid #2C3141;
    border-radius: 10px;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #94A3B8;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}
QFrame#Card {
    background-color: #282837;
    border: 1px solid #2C3141;
    border-radius: 10px;
}
QFrame[role="separator"], QFrame[frameShape="4"], QFrame[frameShape="5"] {
    background: #2C3141;
    border: none;
    max-height: 1px;
}

/* ---- buttons ------------------------------------------------------------- */
QPushButton {
    background-color: #323241;
    color: #F8FAFC;
    border: 1px solid #2C3141;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 30px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #3F3F59;
    border-color: #374151;
}
QPushButton:pressed { background-color: #2B2B44; }
QPushButton:focus { border: 2px solid #7C3AED; outline: none; }
QPushButton:disabled {
    background-color: #282837;
    color: #64748B;
    border-color: #2C3141;
}
QPushButton[accent="true"] {
    background-color: #7C3AED;
    border-color: #7C3AED;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton[accent="true"]:hover { background-color: #8E56F0; border-color: #8E56F0; }
QPushButton[accent="true"]:pressed { background-color: #6831C7; }
QPushButton[accent="true"]:disabled { background-color: #332458; color: #64748B; }
QPushButton[danger="true"] {
    background-color: #EF4444;
    border-color: #EF4444;
    color: #101014;
    font-weight: 600;
}
QPushButton[danger="true"]:hover { background-color: #F15E5E; border-color: #F15E5E; }
QPushButton[flat="true"] { background: transparent; border-color: transparent; }
QPushButton[flat="true"]:hover { background: #3F3F59; }

/* ---- inputs -------------------------------------------------------------- */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1E1E2E;
    color: #F8FAFC;
    border: 1px solid #374151;
    border-radius: 4px;
    padding: 5px 10px;
    min-height: 30px;
    selection-background-color: #7C3AED;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #64748B;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid #7C3AED;
    padding: 4px 9px;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background-color: #282837;
    color: #64748B;
}
QLineEdit[valid="false"] { border-color: #EF4444; background-color: #442532; }
QLineEdit[valid="true"] { border-color: #22C55E; }
QLineEdit[role="mono"], QPlainTextEdit[role="mono"], QTextEdit[role="mono"] {
    font-family: "JetBrains Mono", "Roboto Mono", "DejaVu Sans Mono", "Consolas", monospace;
    letter-spacing: 0.5px;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}
QComboBox QAbstractItemView {
    background-color: #323241;
    border: 1px solid #374151;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #7C3AED;
    selection-color: #FFFFFF;
    outline: none;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 16px;
}

/* ---- tabs ---------------------------------------------------------------- */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #2C3141;
    background: transparent;
    top: -1px;
}
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    background: transparent;
    color: #94A3B8;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    margin-right: 2px;
    font-weight: 500;
}
QTabBar::tab:hover { color: #F8FAFC; background: #282837; }
QTabBar::tab:selected {
    color: #F8FAFC;
    border-bottom: 2px solid #7C3AED;
    font-weight: 600;
}
QTabBar::tab:disabled { color: #64748B; }

/* ---- tables and trees ---------------------------------------------------- */
QHeaderView { background: transparent; }
QHeaderView::section {
    background-color: #282837;
    color: #94A3B8;
    border: none;
    border-bottom: 1px solid #374151;
    padding: 7px 10px;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    min-height: 30px;
}
QHeaderView::section:hover { background-color: #323241; color: #F8FAFC; }
QTableView, QTreeView, QListView, QTableWidget, QListWidget {
    background-color: #282837;
    alternate-background-color: #1E1E2E;
    border: 1px solid #2C3141;
    border-radius: 6px;
    gridline-color: #2C3141;
    outline: none;
}
QTableView::item, QTreeView::item, QListView::item {
    padding: 4px 6px;
    min-height: 26px;
    border: none;
}
QTableView::item:hover, QTreeView::item:hover, QListView::item:hover {
    background-color: #3F3F59;
}
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background-color: #7C3AED;
    color: #FFFFFF;
}
QTreeView::branch { background: transparent; }
QTableCornerButton::section { background: #282837; border: none; }

/* ---- scrollbars ---------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #3C3C4A;
    border-radius: 6px;
    min-height: 28px;
    min-width: 28px;
    margin: 2px;
}
QScrollBar::handle:hover { background: #64748B; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---- menus and toolbars -------------------------------------------------- */
QMenuBar {
    background-color: #282837;
    border-bottom: 1px solid #2C3141;
    padding: 2px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected { background: #3F3F59; }
QMenu {
    background-color: #323241;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 28px 7px 12px;
    border-radius: 4px;
}
QMenu::item:selected { background-color: #7C3AED; color: #FFFFFF; }
QMenu::separator {
    height: 1px;
    background: #2C3141;
    margin: 5px 8px;
}
QToolBar {
    background: #282837;
    border: none;
    border-bottom: 1px solid #2C3141;
    padding: 5px 8px;
    spacing: 8px;
}
QToolBar::separator {
    background: #2C3141;
    width: 1px;
    margin: 5px 8px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    color: #F8FAFC;
}
QToolButton:hover { background: #3F3F59; }
QToolButton:pressed { background: #2B2B44; }
QToolButton:checked {
    background: #332458;
    border-color: #7C3AED;
    color: #F8FAFC;
}

/* ---- status bar, docks, splitters ---------------------------------------- */
QStatusBar {
    background: #282837;
    border-top: 1px solid #2C3141;
    color: #94A3B8;
    min-height: 26px;
}
QStatusBar::item { border: none; }
QDockWidget { color: #94A3B8; titlebar-close-icon: none; }
QDockWidget::title {
    background: #282837;
    padding: 7px 10px;
    border-bottom: 1px solid #2C3141;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}
QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: #332458; }
QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }

/* ---- selection controls -------------------------------------------------- */
QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #64748B;
    background: #1E1E2E;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #7C3AED; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #7C3AED;
    border-color: #7C3AED;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: #2C3141;
    background: #282837;
}

/* ---- progress ------------------------------------------------------------ */
QProgressBar {
    background-color: #323241;
    border: none;
    border-radius: 5px;
    height: 10px;
    text-align: center;
    color: #94A3B8;
    font-size: 11px;
}
QProgressBar::chunk { background-color: #7C3AED; border-radius: 5px; }

/* ---- tooltips ------------------------------------------------------------ */
QToolTip {
    background-color: #3C3C4A;
    color: #F8FAFC;
    border: 1px solid #374151;
    padding: 6px 10px;
    border-radius: 4px;
    opacity: 240;
}

/* ---- application specific ------------------------------------------------ */
QWidget#LedIndicator { background: transparent; }
QFrame#Toast {
    background-color: #3C3C4A;
    border: 1px solid #374151;
    border-radius: 10px;
    padding: 12px 16px;
}
QWidget#ServiceGrid, QFrame#ServiceCard {
    background-color: #282837;
    border: 1px solid #2C3141;
    border-radius: 6px;
}
QWidget#ServiceGrid[dragging="true"], QFrame#ServiceCard[dragging="true"] {
    border: 1px dashed #7C3AED;
}
QWidget#SidePanel {
    background-color: #282837;
    border-right: 1px solid #2C3141;
}
QTableView#LogTable {
    font-family: "JetBrains Mono", "Roboto Mono", "DejaVu Sans Mono", "Consolas", monospace;
    alternate-background-color: #282837;
    background-color: #1E1E2E;
}

